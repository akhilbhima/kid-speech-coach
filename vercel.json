{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/speech-coach/api/:path*", "destination": "/api/:path*" },
    { "source": "/speech-coach", "destination": "/index.html" },
    { "source": "/speech-coach/", "destination": "/index.html" },
    { "source": "/speech-coach/:path*", "destination": "/:path*" }
  ]
}
